generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
 
}

model User {
  id       String   @id @default(uuid())
  email    String   @unique
  password String
  name     String?
  tasks    Task[]
}

model Task {
  id        String   @id @default(uuid())
  title     String
  status    Status   @default(TODO)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

enum Status {
  TODO
  IN_PROGRESS
  DONE
}